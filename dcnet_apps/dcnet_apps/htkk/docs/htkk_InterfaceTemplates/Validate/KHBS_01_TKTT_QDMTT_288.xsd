														<xs:documentation>2. Lợi nhuận trước thuế thu nhập doanh nghiệp hoặc lỗ của Tập đoàn đa quốc gia tại Việt Nam</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="tongThue_DonGianHoa" type="xs:decimal" nillable="true">
