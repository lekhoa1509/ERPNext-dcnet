													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Muc_2.2">
										<xs:annotation>
											<xs:documentation>2.2 Số thuế thu nhập doanh nghiệp bổ sung tối thiểu nội địa đạt chuẩn được xác định bằng 0</xs:documentation>
										</xs:annotation>
