														<xs:documentation>3. Tổng các khoản thuế thuộc phạm vi áp dụng được đơn giản hóa</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="thueSuatThucTe_DonGianHoa" type="xs:decimal" nillable="true">
