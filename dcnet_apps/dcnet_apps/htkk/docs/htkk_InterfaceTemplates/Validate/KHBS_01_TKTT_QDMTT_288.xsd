																<xs:annotation>
																	<xs:documentation>6. Giá trị tài sản hữu hình hợp lệ được phân bổ cho cơ sở thường trú</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="chiTienLuong_PhanBo" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>7. Chi tiền lương hợp lệ sau phân bổ của công ty chính</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="giaTriTaiSan_PhanBo" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>8. Giá trị tài sản hữu hình hợp lệ sau phân bổ của công ty chính</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
