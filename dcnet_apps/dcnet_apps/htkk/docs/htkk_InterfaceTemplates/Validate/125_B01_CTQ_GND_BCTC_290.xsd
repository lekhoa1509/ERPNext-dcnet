															<xs:element name="ct25" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>5.Tiền chi đầu tư góp vốn vào đơn vị khác</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct26" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.Tiền thu hồi đầu tư góp vốn vào đơn vị khác</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct27" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>7.Tiền thu cổ tức và lợi nhuận được chia</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct30" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Lưu chuyển tiền thuần từ hoạt động đầu tư 30=21+22+…+27</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct31" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>1.Tiền thu từ phát hành cổ phiếu, trái phiếu, nhận vốn góp của chủ sở hữu</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct32" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>2.Tiền chi trả vốn góp cho các chủ sở hữu, mua lại cổ phiếu của công ty đã phát hành</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct33" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>3.Tiền vay ngắn hạn, dài hạn nhận được</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct34" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>4.Tiền chi trả nợ gốc vay</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct35" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>5.Tiền chi trả nợ thuê tài chính</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct36" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>6. Cổ tức, lợi nhuận đã trả cho chủ sở hữu</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct40" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Lưu chuyển tiền thuần từ hoạt động tài chính 40=31+32+…+36</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct50" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Lưu chuyển tiền thuần trong kỳ (50 = 20+30+40)</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct60" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Tiền và tương đương tiền đầu kỳ</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct61" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Ảnh hưởng của thay đổi tỷ giá hối đoái quy đổi ngoại tệ</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct70" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>Tiền và tương đương tiền cuối kỳ (70 = 50+60+61)</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
