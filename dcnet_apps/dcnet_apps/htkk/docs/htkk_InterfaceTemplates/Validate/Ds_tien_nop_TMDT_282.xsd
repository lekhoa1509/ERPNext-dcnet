												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="TieuMuc1003">
										<xs:annotation>
											<xs:documentation>Tiểu mục 1003 – Thuế TNCN</xs:documentation>
