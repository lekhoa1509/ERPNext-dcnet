	<xs:redefine schemaLocation="../TKhaiThue.xsd">
		<xs:complexType name="CTieuTKhaiChinhType">
			<xs:complexContent>
				<xs:extension base="CTieuTKhaiChinhType">
					<xs:sequence>
						<xs:element name="Header">
							<xs:annotation>
								<xs:documentation>Thông tin chung</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="soChungTu" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Số chứng từ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="soThamChieu" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Số tham chiếu</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ngay" type="xs:date" nillable="true">
										<xs:annotation>
											<xs:documentation>Ngày chứng từ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct5_maloai" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã loại Số tờ khai/ Số quyết định / Số thông báo/Mã định danh hồ sơ (ID)                
1: Số tờ khai     
2: Số quyết định
3: Số thông báo
4: Mã định danh hồ sơ                               </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct5" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Gía trị nhập tương ứng của chỉ tiêu 5                              </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct6_kyThue">
										<xs:annotation>
											<xs:documentation>Kỳ thuế/ Ngày quyết định/Ngày thông báo:</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="loai">
													<xs:annotation>
														<xs:documentation>Chọn kỳ thuế/ngày quyết đinh/Ngày thông báo</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string"/>
													</xs:simpleType>
												</xs:element>
												<xs:element name="tenKy" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên loại kỳ                             </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="KyKeKhai" type="xs:string">
													<xs:annotation>
														<xs:documentation>Kỳ thuế: Nếu chỉ tiêu [05] chọn “Số tờ khai” thì bắt buộc nhập kỳ tính thuế tháng theo định dạng mm/yyyy
- Ngày quyết định: Nếu chỉ tiêu [05] chọn “Số quyết định” thì mở khóa và bắt buộc nhập theo định dạng dd/mm/yyyy
- Ngày thông báo: Nếu chỉ tiêu [05] chọn “Số thông báo” thì mở khóa và bắt buộc nhập theo định dạng dd/mm/yyyy
</xs:documentation>
													</xs:annotation>
