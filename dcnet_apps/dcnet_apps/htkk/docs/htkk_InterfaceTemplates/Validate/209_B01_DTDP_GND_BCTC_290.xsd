															</xs:element>
															<xs:element name="ct14" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>14. Tăng, giảm tiền vốn nhận ủy thác cấp phát đầu tư</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct15" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>15. Tăng, giảm tiền nhận vốn ủy thác hỗ trợ lãi suất </xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct16" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>16. Tăng, giảm tiền vốn nhận ủy thác cho vay đầu tư</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct17" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>17. Tăng, giảm tiền nhận ủy thác ứng vốn</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct18" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>18. Tăng, giảm tiền nhận hợp vốn cho vay đầu tư</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct19" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>19. Tăng, giảm các Khoản phải trả người bán, người lao động, phải trả khác</xs:documentation>
