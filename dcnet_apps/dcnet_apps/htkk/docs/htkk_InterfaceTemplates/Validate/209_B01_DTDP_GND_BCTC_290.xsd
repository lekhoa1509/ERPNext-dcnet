																</xs:annotation>
															</xs:element>
															<xs:element name="ct06" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>6. Tăng, giảm tiền cho vay </xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct07" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>7. Tăng, giảm lãi, phí phải thu</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct08" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>8. Tăng, giảm các Khoản phải thu vốn đưa đi ủy thác cho vay, tham gia hợp vốn cho vay</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct09" type="xs:long" nillable="true">
																<xs:annotation>
																	<xs:documentation>9. Tăng, giảm các Khoản phải thu của khách hàng từ hoạt động đầu tư trực tiếp </xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct10" type="xs:long" nillable="true">
