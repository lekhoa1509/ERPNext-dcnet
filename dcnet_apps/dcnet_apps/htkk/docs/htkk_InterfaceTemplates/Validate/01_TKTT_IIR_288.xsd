															<xs:element name="ten_Loai" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>Loại 01_Quốc gia, 02- Nhóm đơn vị, 03-Đơn vị hợp thành, liên doanh, công ty con, 04-Cơ sở điều chỉnh, 05-Đơn vị liên quan</xs:documentation>
																</xs:annotation>
															</xs:element>
