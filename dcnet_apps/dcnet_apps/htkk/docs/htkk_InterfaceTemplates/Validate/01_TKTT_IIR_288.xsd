																</xs:annotation>
															</xs:element>
															<xs:element name="ten_QuocGiaDonVi" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>10. Quốc gia đơn vị hợp thành, liên doanh, công ty con của liên doanh liên quan cư trú</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="thuNhap_DieuChinhTang" type="xs:decimal" nillable="true">
