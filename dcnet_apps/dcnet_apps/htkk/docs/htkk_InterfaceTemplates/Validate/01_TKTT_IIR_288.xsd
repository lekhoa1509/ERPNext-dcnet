																	<xs:documentation>3. Tên nhóm đơn vị được yêu cầu tính toán thuế suất thực tế, thuế bổ sung riêng tại quốc gia (nếu có)</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ten_DonViLienDoanh" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>4. Tên đơn vị hợp thành, liên doanh, công ty con của liên doanh</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="mst_DonViLienDoanh" type="xs:string" nillable="true">
																<xs:annotation>
																	<xs:documentation>5. Mã số thuế/mã số doanh nghiệp của đơn vị hợp thành, liên doanh, công ty con của liên doanh</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.1" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.1. Chi phí thuế hoãn lại đối với các khoản không được đưa vào khi tính thu nhập hoặc lỗ theo Quy định về thuế tối thiểu toàn cầu</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.2" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.2. Chi phí thuế hoãn lại đối với các khoản trích trước không được chấp nhận </xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.3" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.3. Chi phí thuế hoãn lại đối với các khoản trích trước chưa được tính</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.4" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.4. Kết quả từ các điều chỉnh cách thức xác định giá trị hoặc điều chỉnh việc ghi nhận kế toán liên quan đến tài sản thuế hoãn lại</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.5" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.5. Chi phí thuế hoãn lại phát sinh từ việc tính toán lại do thay đổi thuế suất áp dụng tại một nước</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.6" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.6. Chi phí thuế hoãn lại từ việc tạo lập và sử dụng các khoản giảm trừ nghĩa vụ thuế</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.7" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.7. Khoản lỗ thay thế từ tài sản thuế hoãn lại được chuyển kỳ sau</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.8" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.8. Các khoản trích trước chưa được tính đã được thanh toán trong năm tài chính</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.9" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.9. Các khoản thuế hoãn lại phải trả được thu hồi được xác định trong năm tài chính trước đó và đã được nộp trong năm tài chính hiện hành</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.10" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.10. Tài sản thuế hoãn lại do lỗ của năm tài chính hiện hành phát sinh lỗ, nhưng tài sản thuế hoãn lại do lỗ đó không được ghi trên báo cáo tài chính vì không đáp ứng tiêu chuẩn được kế toán ghi nhận là tài sản thuế hoãn lại</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ct_6.11" type="xs:decimal" nillable="true">
																<xs:annotation>
																	<xs:documentation>6.11. Khoản điều chỉnh chi phí thuế hoãn lại do giảm thuế suất</xs:documentation>
