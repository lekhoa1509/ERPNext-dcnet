<xs:schema xmlns="http://kekhaithue.gdt.gov.vn/TKhaiThue" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://kekhaithue.gdt.gov.vn/TKhaiThue" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.1.5">
	<xs:redefine schemaLocation="../TKhaiThue.xsd">
		<xs:complexType name="CTieuTKhaiChinhType">
			<xs:complexContent>
				<xs:extension base="CTieuTKhaiChinhType">
					<xs:sequence>
						<xs:element name="Header">
							<xs:annotation>
								<xs:documentation>Thông tin chung</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="soChungTu" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Số chứng từ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="soThamChieu" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Số tham chiếu</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ngay" type="xs:date" nillable="true">
										<xs:annotation>
											<xs:documentation>Ngày chứng từ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct5_maloai" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã loại Số tờ khai/ Số quyết định / Số thông báo/Mã định danh hồ sơ (ID)                
1: Số tờ khai     
2: Số quyết định
3: Số thông báo
4: Mã định danh hồ sơ                               </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct5" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Gía trị nhập tương ứng của chỉ tiêu 5                              </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct6_kyThue">
										<xs:annotation>
											<xs:documentation>Hình thức hoàn trả</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="LoaiKy">
													<xs:annotation>
														<xs:documentation>Chọn Tháng M, Quý Q, Năm Y, lần phát sinh D</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string"/>
													</xs:simpleType>
												</xs:element>
												<xs:element name="tenKy" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên loại kỳ                             </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="KyKeKhai" type="xs:string">
													<xs:annotation>
														<xs:documentation>Quý: Q/YYYY, tháng: MM/YYYY, năm: YYYY, lần phát sinh: DD/MM/YYYY</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ct6_ngayQD" type="xs:date" nillable="true">
										<xs:annotation>
											<xs:documentation>Ngày quyết định</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct6_ngayTB" type="xs:date" nillable="true">
										<xs:annotation>
											<xs:documentation>Ngày thông báo </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct7_tieuMuc" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Mã tiểu mục</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct7_tentieuMuc" type="xs:string" nillable="true">
										<xs:annotation>
											<xs:documentation>Tên tiểu mục</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct8_soTienDaNop" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng số tiền đã nộp NSNN</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ct9_soNopThua" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng số tiền đã nộp thừa kỳ trước (nếu có)</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="NoiDungDS">
							<xs:annotation>
								<xs:documentation>Nội dung chi tiết danh sách thuế TNCN</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="CTietDS" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Bảng kê bù trừ cho khoản phải nộp NSNN</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ct2_MST" type="TINType" nillable="true">
													<xs:annotation>
														<xs:documentation>Mã số thuế</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct3_tenNNT" type="xs:string" nillable="true">
													<xs:annotation>
														<xs:documentation>Tên NNT</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct4_soKhauTru" type="xs:decimal" nillable="true">
													<xs:annotation>
														<xs:documentation>Số tiền đã khấu trừ</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct5_soDaNop" type="xs:decimal" nillable="true">
													<xs:annotation>
														<xs:documentation>Số tiền đã nộp NSNN</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ct6_soNopThua" type="xs:decimal" nillable="true">
													<xs:annotation>
														<xs:documentation>Số nộp thừa kỳ trước được bù trừ (nếu có)</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
											<xs:attribute name="id" type="xs:string"/>
										</xs:complexType>
									</xs:element>
									<xs:element name="tongCot4" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng cộng số tiền đã khấu trừ </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="tongCot5" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Tổng cộng số tiền đã nộp NSNN</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="tongCot6" type="xs:decimal" nillable="true">
										<xs:annotation>
											<xs:documentation>Tong cong Số nộp thừa kỳ trước được bù trừ (nếu có)</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="nguoiNopTien" type="xs:string" nillable="true">
							<xs:annotation>
								<xs:documentation>Người nộp tiền</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="keToanTruong" type="xs:string" nillable="true">
							<xs:annotation>
								<xs:documentation>Kế toán trưởng</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:redefine>
</xs:schema>
